{
  "packages": ["nodejs@24", "postgresql@17", "pnpm@latest"],
  "env": {
    "PATH": "$PWD/node_modules/.bin:$PATH"
  },
  "shell": {
    "init_hook": [
      "echo 'Welcome to TransMenu development environment!'",
      "echo 'Node.js version:'",
      "node --version",
      "echo 'npm version:'",
      "npm --version",
      "echo 'PostgreSQL version:'",
      "postgres --version"
    ]
  }
}
